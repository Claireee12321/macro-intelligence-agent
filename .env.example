# Copy to .env (gitignored). In GitHub Actions these come from repository secrets/variables.

# ── Data collectors ──────────────────────────────────────────────────────────
# module:Class implementing macro_intel.collect.Collectors (see docs/COLLECTORS.md)
# MACRO_COLLECTORS=my_collectors:MyCollectors
# Optional API key passed to your collectors' update_series() (e.g. for an economic-data API)
FRED_API_KEY=

# ── LLM (optional; OFF by default — nothing is called unless LLM_PROVIDER is set) ──
# LLM_PROVIDER: none | anthropic | openai_compat
LLM_PROVIDER=none
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=high
ANTHROPIC_API_KEY=
# OpenAI-compatible endpoint (optional alternative)
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=

# Cost guards
LLM_MAX_EVENT_ANALYSES_PER_RUN=6
LLM_MAX_CALLS_PER_DAY=20
LLM_DAILY_BUDGET_USD=1.00
LLM_MIN_IMPORTANCE=60

# Where state and site JSON are written (default ./data)
# MACRO_DATA_DIR=
